          "id": "pc_offer_signed",
          "message": "Offer must be signed by both parties and 10 day reflection period elapsed",
          "citations": [
            "p2-4"
          ],
          "expression": "offer_signed == true && reflection_days >= 10",
          "plain_text": "Offer signed and reflection period elapsed"
        },
