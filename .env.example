# Copy this file to .env and set your key.
ZOTRA_ADDR=:8080
ZOTRA_DATABASE_URL=postgres://zotra:zotra@localhost:5432/zotra?sslmode=disable

# Meta Model API (OpenAI-compatible)
ZOTRA_AI_BASE_URL=https://api.meta.ai/v1
ZOTRA_AI_API_KEY=
ZOTRA_AI_TEXT_MODEL=muse-spark-1.3
ZOTRA_AI_SAM_MODEL=sam-3.1

# live, cache, replay or off
ZOTRA_AI_MODE=cache
ZOTRA_AI_BUDGET_USD=2
ZOTRA_AI_CACHE_DIR=local/ai-cache
