    { "name": "monthly_income", "label": "Monthly income", "type": "money", "options": [], "computed": null },
    {
      "name": "monthly_payment",
      "label": "Monthly payment",
      "type": "money",
      "options": [],
      "computed": "amount * (annual_rate / 12.0) / (1.0 - pow(1.0 + annual_rate / 12.0, -duration_months))"
    },
    {
      "name": "debt_ratio",
      "label": "Debt ratio",
      "type": "number",
      "options": [],
      "computed": "monthly_payment / monthly_income"
    },
